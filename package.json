{
  "name": "tenantflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
